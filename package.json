{
  "name": "appsearchly",
  "version": "0.1.0",
  "private": true,
  "description": "AI tool discovery, comparison, and growth intelligence platform",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:worker": "wrangler dev",
    "build": "vite build && node scripts/write-worker-entry.mjs",
    "preview": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:production": "npm run production:preflight:deploy && npm run production:config && npm run build && wrangler deploy --config wrangler.production.generated.jsonc",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "check:docs": "node scripts/check-docs.js",
    "check:runtime": "node scripts/check-runtime-config.mjs",
    "production:preflight": "node scripts/production-preflight.mjs",
    "production:preflight:deploy": "node scripts/production-preflight.mjs --deployment",
    "production:config": "node scripts/render-production-config.mjs",
    "production:smoke": "node scripts/smoke-production.mjs",
    "production:smoke:publish-flow": "node scripts/smoke-publish-flow.mjs",
    "audit:data": "node scripts/audit-tools.mjs",
    "audit:data:strict": "node scripts/audit-tools.mjs --strict",
    "prepare:import": "node scripts/prepare-tool-import.mjs",
    "prepare:import:strict": "node scripts/prepare-tool-import.mjs --strict",
    "db:migrate": "node scripts/migrate-database.mjs",
    "test:submission-quality": "node scripts/test-submission-quality.mjs",
    "test:publish-flow:e2e": "svelte-kit sync && node --import tsx scripts/test-publish-flow-e2e.mjs",
    "test:turnstile:e2e": "node --import tsx scripts/test-turnstile-submission-e2e.mjs",
    "seed:tools": "node --import tsx scripts/seed-tools.ts",
    "test:tools-data": "svelte-kit sync && node --import tsx scripts/test-tool-data-platform.mjs",
    "test:acquisition": "svelte-kit sync && node --import tsx scripts/test-acquisition-engine.mjs",
    "test:seo": "svelte-kit sync && node --import tsx scripts/test-seo-growth.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.65.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "lucide-svelte": "^1.0.1",
    "postcss": "^8.5.14",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "fs-extra": "^11.3.2",
    "fuse.js": "^7.3.0",
    "pg": "^8.16.3"
  },
  "engines": { "node": ">=20.19.0" }
}
