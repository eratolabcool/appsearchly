# Public configuration
PUBLIC_SITE_URL=https://appsearchly.org
APP_ENV=development

# Local PostgreSQL / migration tooling only.
# Production Workers should use the HYPERDRIVE binding instead of exposing
# DATABASE_URL to browser code.
DATABASE_URL=postgresql://appsearchly:change-me@127.0.0.1:5432/appsearchly

# Server-only authentication secrets. Never prefix secrets with VITE_ or PUBLIC_.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional server-side integrations
EMAIL_FROM=noreply@appsearchly.org
AFFILIATE_TOKEN=

# Cloudflare bindings are configured in wrangler.jsonc / the dashboard:
# - HYPERDRIVE
# - TOOL_ASSETS (R2, later P0 batch)
