# Public configuration
PUBLIC_SITE_URL=https://appsearchly.com
APP_ENV=development
DATA_SOURCE_MODE=dual
PUBLIC_TURNSTILE_SITE_KEY=

# Local migration tooling only. Production Workers connect through HYPERDRIVE.
DATABASE_URL=postgresql://appsearchly:change-me@127.0.0.1:5432/appsearchly

# Server-only secrets. Store real values as GitHub Environment and Cloudflare Worker secrets.
ADMIN_API_TOKEN=replace-with-at-least-32-random-bytes
TURNSTILE_SECRET_KEY=

# Production deployment inputs. Never commit real account values.
APPSEARCHLY_WORKER_NAME=appsearchly
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_HYPERDRIVE_ID=
ALLOW_POSTGRES_CUTOVER=false
WRANGLER_PRODUCTION_CONFIG=wrangler.production.generated.jsonc
APP_BASE_URL=https://appsearchly.eratolabcool.workers.dev

# Optional server-side integrations
EMAIL_FROM=noreply@appsearchly.com
AFFILIATE_TOKEN=

# Cloudflare bindings:
# - HYPERDRIVE: PostgreSQL connection
# - ASSETS: generated Worker assets
