# Public configuration
PUBLIC_SITE_URL=https://appsearchly.org
APP_ENV=development
DATA_SOURCE_MODE=dual

# Local PostgreSQL migration tooling only. Production Workers use the
# HYPERDRIVE binding rather than exposing DATABASE_URL to application code.
DATABASE_URL=postgresql://appsearchly:change-me@127.0.0.1:5432/appsearchly

# Server-only administrator API token. Generate at least 32 random bytes.
# Store it with `wrangler secret put ADMIN_API_TOKEN` in production.
ADMIN_API_TOKEN=replace-with-at-least-32-random-bytes

# Optional server-side integrations
EMAIL_FROM=noreply@appsearchly.org
AFFILIATE_TOKEN=

# Cloudflare bindings are configured in wrangler.jsonc / the dashboard:
# - HYPERDRIVE (PostgreSQL connection)
# - ASSETS (generated Worker assets binding)
# - TOOL_ASSETS (R2, later P0 batch)
